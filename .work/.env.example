# .work/.env — Local secrets (NEVER committed to git)
#
# This file is loaded automatically by _setup_env.py and site_config.load().
# Copy this to .env and fill in your real values.
#
# Format: KEY=VALUE (one per line, # for comments)
# Quoting optional: KEY="VALUE" or KEY='VALUE'

# GitHub Personal Access Token (scopes: repo for private repos like conforma-reporter)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# GitLab Personal Access Token (scopes: api, read_repository, write_repository)
# Generate at: https://$GITLAB_HOST/-/user_settings/personal_access_tokens
GITLAB_TOKEN=

# Skip SSL certificate verification for GitLab API calls.
# Set to "false" when running in WSL or environments where the Red Hat internal
# CA certificate (2023 Certificate Authority RHCSv2) is not in the trust store.
# GITLAB_SSL_VERIFY=false

# Jira credentials (for conforma-exception workflows)
# Generate API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=
