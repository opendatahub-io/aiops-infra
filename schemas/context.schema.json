{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conforma Run Context",
  "description": "Schema for context.yaml files in conforma run directories",
  "type": "object",
  "properties": {
    "application": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Product name (e.g. rhoai)"
        },
        "version": {
          "type": "string",
          "description": "Version string (e.g. 3.5-ea.2)"
        },
        "release": {
          "type": "string",
          "description": "Release branch name (e.g. rhoai-3.5-ea.2)"
        },
        "konflux_app": {
          "type": "string",
          "description": "Konflux Application resource name (e.g. rhoai-v3-5-ea-2)"
        }
      },
      "required": ["name", "version", "release", "konflux_app"]
    },
    "environment": {
      "type": "string",
      "enum": ["prod", "stage"],
      "description": "Target environment"
    },
    "resolve": {
      "type": "object",
      "properties": {
        "version_dir": {"type": "string"},
        "cluster_domain": {"type": "string"},
        "cluster_id": {"type": "string"},
        "tenant": {"type": "string"},
        "conforma_policy_dir": {"type": "string"},
        "policy_files": {
          "type": "array",
          "items": {"type": "string"}
        },
        "self_service_files": {
          "type": "array",
          "items": {"type": "string"}
        },
        "end_of_support": {"type": ["string", "null"]},
        "upcoming_release_date": {"type": ["string", "null"]},
        "code_freeze_date": {"type": ["string", "null"]},
        "links": {
          "type": "object",
          "additionalProperties": true
        },
        "confirmation_display": {
          "type": "string",
          "description": "Pre-rendered markdown context confirmation table for report metadata headers"
        }
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "description": "ISO 8601 timestamp of run creation"
        },
        "run_dir": {
          "type": "string",
          "description": "Absolute path to the run directory (with ~ notation)"
        }
      },
      "required": ["created_at", "run_dir"]
    },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["pending", "running", "completed", "failed"]
          },
          "completed_at": {"type": ["string", "null"]}
        }
      }
    }
  },
  "required": ["run"]
}
