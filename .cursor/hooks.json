{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".githooks/check-pending-preferences.sh"
      }
    ],
    "stop": [
      {
        "command": "hooks/run-unit-tests.sh",
        "loop_limit": 3
      },
      {
        "command": "hooks/validate-guide-links.sh",
        "loop_limit": 1
      }
    ]
  }
}
