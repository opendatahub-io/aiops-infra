#!/bin/bash
# Discover user coding preference corrections from recent AI sessions.
# Runs after every commit — non-blocking, append-only.
# High-confidence terminology rules auto-add to AGENTS.md.
# Lower-confidence rules queue in ~/.conforma/proposed-conventions.yaml for review.

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRIPT="$REPO_ROOT/scripts/extract_user_coding_preferences.py"

[ -f "$SCRIPT" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

python3 "$SCRIPT" \
  --since-hours 4 \
  --diff "HEAD~1..HEAD" \
  --output "$HOME/.conforma/proposed-conventions.yaml" \
  --agents-md "$REPO_ROOT/AGENTS.md" \
  --quiet &

exit 0
